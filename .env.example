# Required for all deployments. Never commit real credentials or encryption keys.
TUNEBRIDGE_WEBDAV_USERNAME=oneplayer
TUNEBRIDGE_WEBDAV_PASSWORD=change-me

# Required to enable the live Netease adapter and QR login.
TUNEBRIDGE_NETEASE_API_BASE_URL=https://netease-api.example.internal
TUNEBRIDGE_SESSION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

TUNEBRIDGE_PREFERRED_QUALITY=lossless
TUNEBRIDGE_LYRICS_MODE=original_translation
TUNEBRIDGE_COMPAT_TRACE=false
